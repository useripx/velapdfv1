# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Rujukan Organisasi: config/organization.md
# Aturan: PILAR 3 - ZERO SECRET LEAKAGE (Docs/universal-rule.md)
# 
# PANDUAN PENGGUNAAN:
# 1. Jangan pernah menuliskan kunci API, token, atau kata sandi nyata di berkas ini!
# 2. Salin berkas ini ke '.env' untuk penggunaan lokal.
# 3. Pastikan '.env' tidak pernah di-commit ke repositori git (periksa .gitignore).
# ==============================================================================

# Konfigurasi Aplikasi
APP_NAME="[Isi Manual: Nama Proyek]"
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000
APP_URL=http://localhost:3000

# Konfigurasi Database (Opsional - sesuaikan dengan arsitektur proyek)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Kunci API / Layanan Eksternal (Dummy Placeholder)
API_SERVICE_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_key_here

# Penyimpanan / Storage
STORAGE_DRIVER=local
