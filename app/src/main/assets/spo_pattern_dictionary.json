{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "dictionaryId": "SPO-VELAPDF-ID-2026",
  "version": "1.1.0",
  "description": "Kamus Pola Ekstraksi Fakta Semantik SPO (Subjek-Predikat-Objek) berbasis JSON dengan pemetaan eksplisit ke kelas/properti Ontologi dan guard anti-negasi.",
  "patterns": [
    {
      "patternId": "SPO_DOC_NUMBER",
      "domainScope": "FORMAL",
      "description": "Mengekstrak nomor naskah dinas / peraturan resmi.",
