{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "dictionaryId": "SPO-VELAPDF-ID-2026",
  "version": "1.0.0",
  "description": "Kamus Pola Ekstraksi Fakta Semantik SPO (Subjek-Predikat-Objek) berbasis JSON untuk Dokumen Resmi dan Buku Ajar/Teknis Bahasa Indonesia.",
  "patterns": [
    {
      "patternId": "SPO_DOC_NUMBER",
      "domainScope": "FORMAL",
      "description": "Mengekstrak nomor naskah dinas / peraturan resmi.",
      "subject": "Dokumen",
      "subjectGroup": 0,
      "predicate": "memilikiNomor",
      "category": "METADATA_DOKUMEN",
      "regexPattern": "(?i)(?:Nomor(?:\\s+(?:Dokumen|Surat|SK|Induk|Registrasi))?|No\\.)\\s*[:=]?\\s*([A-Za-z0-9/\\-–.]+(?:\\s+TAHUN\\s+\\d{4})?)",
      "objectGroup": 1,
      "minObjectLength": 3,
      "maxObjectLength": 60,
      "requireDigitInObject": true
    },
    {
      "patternId": "SPO_DOC_DATE",
      "domainScope": "FORMAL",
      "description": "Mengekstrak tanggal penerbitan / penetapan dokumen resmi.",
      "subject": "Dokumen",
      "subjectGroup": 0,
      "predicate": "diterbitkanPadaTanggal",
      "category": "METADATA_DOKUMEN",
      "regexPattern": "(?i)(?:tanggal(?:\\s+(?:dokumen|berlaku|ditetapkan|surat))?\\s*[:=]?|ditetapkan\\s*di\\s*[A-Za-z\\s]+,?\\s*pada\\s*tanggal\\s*[:=]?|pada\\s*tanggal\\s*[:=]?)\\s*(\\d{1,2}\\s+[A-Za-z]+\\s+\\d{4})",
      "objectGroup": 1,
      "minObjectLength": 6,
      "maxObjectLength": 40,
      "requireDigitInObject": true
    },
    {
      "patternId": "SPO_DOC_SUBJECT",
      "domainScope": "ALL",
      "description": "Mengekstrak perihal atau judul pokok bahasan dokumen.",
      "subject": "Dokumen",
      "subjectGroup": 0,
      "predicate": "memuatPerihal",
      "category": "METADATA_DOKUMEN",
      "regexPattern": "(?i)(?:tentang|perihal|hal|pokok\\s+bahasan|topik\\s+bab)\\s*[:=]?\\s*([^\\n]{6,160})",
      "objectGroup": 1,
      "minObjectLength": 6,
      "maxObjectLength": 160,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_DOC_ISSUER",
      "domainScope": "FORMAL",
      "description": "Mengekstrak pejabat atau institusi penerbit berwenang.",
      "subject": "PihakPenerbit",
      "subjectGroup": 0,
      "predicate": "memilikiKewenangan",
      "category": "METADATA_DOKUMEN",
      "regexPattern": "(?i)((?:wakil\\s+)?(?:rektor|dekan|kepala|direktur|kementerian|yayasan|ketua(?:\\s+[A-Za-z0-9\\s.,()-]{2,60})?|badan\\s*pengawas)(?:\\s+[A-Za-z0-9\\s.,()-]{2,60})?)",
      "objectGroup": 1,
      "minObjectLength": 5,
      "maxObjectLength": 90,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_OBLIGATION",
      "domainScope": "FORMAL",
      "description": "Mengekstrak klausa kewajiban yang harus dipatuhi pihak terkait.",
      "subject": "PihakTerkait",
      "subjectGroup": 0,
      "predicate": "memilikiKewajiban",
      "category": "KLAUSUL_KEWAJIBAN",
      "regexPattern": "(?i)(?:wajib|diharuskan|wajib\\s*mengikuti|harus|dimohon\\s*untuk)\\s+([^.,;\\n]{8,180})",
      "objectGroup": 1,
      "minObjectLength": 8,
      "maxObjectLength": 180,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_DEADLINE",
      "domainScope": "FORMAL",
      "description": "Mengekstrak tenggat atau batas akhir pelaksanaan ketentuan.",
      "subject": "BatasWaktu",
      "subjectGroup": 0,
      "predicate": "berakhirPada",
      "category": "BATAS_WAKTU_DEADLINE",
      "regexPattern": "(?i)(?:paling\\s*lambat|sampai\\s*dengan|batas\\s*akhir|tenggat\\s*waktu|terakhir\\s*pada)\\s+(?:tanggal\\s+)?([^.,;\\n]{5,120})",
      "objectGroup": 1,
      "minObjectLength": 5,
      "maxObjectLength": 120,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_PROHIBITION",
      "domainScope": "FORMAL",
      "description": "Mengekstrak klausa larangan eksplisit.",
      "subject": "PihakTerkait",
      "subjectGroup": 0,
      "predicate": "memilikiLarangan",
      "category": "KLAUSUL_LARANGAN",
      "regexPattern": "(?i)(?:dilarang(?:\\s+keras)?|tidak\\s*diperkenankan|tidak\\s*boleh)\\s+([^.,;\\n]{8,180})",
      "objectGroup": 1,
      "minObjectLength": 8,
      "maxObjectLength": 180,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_CHAPTER_TOPIC",
      "domainScope": "BOOK",
      "description": "Mengekstrak judul bab atau sub-bab pada buku ajar maupun naskah referensi.",
      "subject": "BabDokumen",
      "subjectGroup": 0,
      "predicate": "membahasTopik",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)^(?:bab\\s+[ivx0-9]+(?:\\s*[:.\\-]\\s*)?|[0-9]+\\.[0-9]+\\s+)([^\\n]{5,110})",
      "objectGroup": 1,
      "minObjectLength": 5,
      "maxObjectLength": 110,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_DEFINITION",
      "domainScope": "BOOK",
      "description": "Mengekstrak hubungan definisi konsep (Subjek adalah/merupakan Objek).",
      "subject": "KonsepUtama",
      "subjectGroup": 1,
      "predicate": "memilikiDefinisi",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)\\b([A-Za-z][A-Za-z0-9\\s\\-()/]{2,45}?)\\s+(?:adalah|merupakan|didefinisikan\\s+sebagai|diartikan\\s+sebagai)\\s+([^.?!\\n]{12,220})",
      "objectGroup": 2,
      "minObjectLength": 12,
      "maxObjectLength": 220,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_COMPONENTS",
      "domainScope": "BOOK",
      "description": "Mengekstrak komponen atau unsur penyusun sistem/perangkat.",
      "subject": "SistemAtauKonsep",
      "subjectGroup": 1,
      "predicate": "memilikiKomponen",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)\\b([A-Za-z][A-Za-z0-9\\s\\-()/]{2,45}?)\\s+(?:terdiri\\s+dari|mencakup|meliputi|tersusun\\s+atas|menggunakan\\s+komponen)\\s+([^.;?!\\n]{10,200})",
      "objectGroup": 2,
      "minObjectLength": 10,
      "maxObjectLength": 200,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_FUNCTION",
      "domainScope": "BOOK",
      "description": "Mengekstrak fungsi, peran, atau kegunaan utama suatu entitas/sistem.",
      "subject": "EntitasSistem",
      "subjectGroup": 1,
      "predicate": "memilikiFungsi",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)\\b([A-Za-z][A-Za-z0-9\\s\\-()/]{2,45}?)\\s+(?:berfungsi\\s+untuk|bertujuan\\s+untuk|digunakan\\s+untuk|berperan\\s+untuk|dimanfaatkan\\s+untuk)\\s+([^.;?!\\n]{10,200})",
      "objectGroup": 2,
      "minObjectLength": 10,
      "maxObjectLength": 200,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_MECHANISM",
      "domainScope": "BOOK",
      "description": "Mengekstrak mekanisme atau cara kerja suatu proses/arsitektur.",
      "subject": "Sistem",
      "subjectGroup": 0,
      "predicate": "bekerjaMelalui",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)(?:cara\\s+kerja(?:\\s+[A-Za-z0-9\\s\\-]{2,25})?|mekanisme\\s+kerja|alur\\s+kerja|bekerja\\s+dengan\\s+cara|bekerja\\s+melalui)\\s*(?:adalah|yaitu|:|\\-)?\\s*([^.;?!\\n]{10,220})",
      "objectGroup": 1,
      "minObjectLength": 10,
      "maxObjectLength": 220,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_ADVANTAGE",
      "domainScope": "BOOK",
      "description": "Mengekstrak keunggulan atau manfaat sistem/metode dalam bacaan.",
      "subject": "KonsepAtauMetode",
      "subjectGroup": 0,
      "predicate": "memilikiKeunggulan",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)(?:kelebihan|keunggulan|manfaat\\s+utama)(?:\\s+[A-Za-z0-9\\s\\-]{2,25})?\\s*(?:adalah|yaitu|meliputi|:)?\\s*([^.;?!\\n]{10,200})",
      "objectGroup": 1,
      "minObjectLength": 10,
      "maxObjectLength": 200,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_LIMITATION",
      "domainScope": "BOOK",
      "description": "Mengekstrak keterbatasan, kendala, atau tantangan teknis.",
      "subject": "KonsepAtauMetode",
      "subjectGroup": 0,
      "predicate": "memilikiKeterbatasan",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)(?:kekurangan|kelemahan|keterbatasan|tantangan\\s+utama)(?:\\s+[A-Za-z0-9\\s\\-]{2,25})?\\s*(?:adalah|yaitu|meliputi|:)?\\s*([^.;?!\\n]{10,200})",
      "objectGroup": 1,
      "minObjectLength": 10,
      "maxObjectLength": 200,
      "requireDigitInObject": false
    },
    {
      "patternId": "SPO_EXPLICIT_CONCLUSION",
      "domainScope": "ALL",
      "description": "Mengekstrak kalimat kesimpulan atau rekomendasi eksplisit dalam dokumen.",
      "subject": "Dokumen",
      "subjectGroup": 0,
      "predicate": "memilikiKesimpulan",
      "category": "POIN_INTISARI",
      "regexPattern": "(?i)(?:kesimpulannya|dapat\\s+disimpulkan(?:\\s+bahwa)?|dengan\\s+demikian|ringkasnya|merekomendasikan(?:\\s+perlunya)?)\\s*[,]?\\s*([^.?!\\n]{12,240})",
      "objectGroup": 1,
      "minObjectLength": 12,
      "maxObjectLength": 240,
      "requireDigitInObject": false
    }
  ]
}
