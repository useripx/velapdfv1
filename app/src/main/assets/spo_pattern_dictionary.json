      "subjectGroup": 0,
      "predicate": "memilikiNomor",
      "ontologyClass": "DokumenResmi",
      "ontologyProperty": "nomorDokumen",
      "ontologyRelation": "hasProperty",
      "category": "METADATA_DOKUMEN",
      "regexPattern": "(?i)(?:Nomor(?:\\s+(?:Dokumen|Surat|SK|Induk|Registrasi))?|No\\.)\\s*[:=]?\\s*([A-Za-z0-9/\\-–.]+(?:\\s+TAHUN\\s+\\d{4})?)",
      "objectGroup": 1,
      "minObjectLength": 3,
      "maxObjectLength": 60,
      "requireDigitInObject": true,
      "negationGuards": []
    },
    {
      "patternId": "SPO_DOC_DATE",
      "domainScope": "FORMAL",
