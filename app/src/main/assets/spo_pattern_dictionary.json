      "regexPattern": "(?i)(?:tentang|perihal|hal|pokok\\s+bahasan|topik\\s+bab)\\s*[:=]?\\s*([^\\n]{6,160})",
      "objectGroup": 1,
      "minObjectLength": 6,
      "maxObjectLength": 160,
      "requireDigitInObject": false,
      "negationGuards": []
    },
